<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bankmanaging.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="Bankmanaging.Views.ActionView"
        x:DataType="vm:ActionViewModel">

    <StackPanel Margin="20" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding Action_AFaire}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <TextBlock Text="Montant"
                   HorizontalAlignment="Center" />
        <TextBox Width="500"
                 Height="20"
                 Name="Montant"
                 PlaceholderText="Entrer la somme"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

        <Button Content="Confirmer"
                HorizontalAlignment="Center" />
        <Button Content="Annuler"
                HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
