<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bankmanaging.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="Bankmanaging.Views.ClientLog"
        x:DataType="vm:MainViewModel">

    <StackPanel Margin="20" Spacing="10" VerticalAlignment="Center">
        <StackPanel>
                <TextBlock Text="Client"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

                <TextBlock Text="Username"
                        HorizontalAlignment="Center"/>
                <TextBox Width="500"
                        Height="20"
                        Name="Username"
                        PlaceholderText="Entrer votre nom d'utilisateur"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

                <TextBlock Text="Password"
                        HorizontalAlignment="Center"/>
                <TextBox Width="500"
                        Height="20"
                        Name="Password"
                        PlaceholderText="Entrer votre mot de passe"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        PasswordChar="*" />      
                <Button Content="Confirmer"
                        
                        HorizontalAlignment="Center"/>
                <Button Content="Annuler"
                        
                        HorizontalAlignment="Center"/>
                <Button Content="Nouveau"
                        
                        HorizontalAlignment="Center"/>
        </StackPanel>
    </StackPanel> 

</UserControl>
