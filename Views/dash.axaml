<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bankmanaging.ViewModels"
    x:Class="Bankmanaging.Views.DashView"
    x:DataType="vm:DashViewModel">

    <Grid RowSpacing="30" 
          ColumnSpacing="20" 
          ColumnDefinitions="*,*,*,*,*" 
          RowDefinitions="*" 
          HorizontalAlignment="Center" 
          VerticalAlignment="Center" 
          Margin="20">

        <Button Grid.Column="0" Grid.Row="0"
                Width="200" Height="400"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#001199" Foreground="#FFD700"
                Command="{Binding ActionClientCommand}">
                <StackPanel>
                        <Image Source="/Assets/icons8-employé-50.png" Width="60" Height="60" Margin="20"/>
                        <TextBlock Text="Client" FontSize="20" HorizontalAlignment="Center"/>
                </StackPanel>
        </Button>

        <Button Grid.Column="1" Grid.Row="0"
                Width="200" Height="400"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#001199" Foreground="#FFD700"
                Command="{Binding TransactionCommand}">
                <StackPanel>
                        <Image Source="/Assets/icons8-transaction-48.png" Width="60" Height="60" Margin="20"/>
                        <TextBlock Text="Transaction" FontSize="20" HorizontalAlignment="Center"/>
                </StackPanel>
        </Button>
     
        <Button Grid.Column="2" Grid.Row="0"
                Width="200" Height="400"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#001199" Foreground="#FFD700"
                Command="{Binding ActionAgenceCommand}"
                CommandParameter="Agence">
                <StackPanel>
                        <Image Source="/Assets/icons8-agence-96.png" Width="60" Height="60" Margin="20"/>
                        <TextBlock Text="Agence" FontSize="20" HorizontalAlignment="Center"/>
                </StackPanel>
        </Button>
                
        <Button Grid.Column="3" Grid.Row="0"
                Width="200" Height="400"  
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#001199" Foreground="#FFD700"
                Command="{Binding ActionHistoriqueCommand}">
                <StackPanel>
                        <Image Source="/Assets/icons8-historique-50.png" Width="60" Height="60" Margin="20"/>
                        <TextBlock Text="Historique" FontSize="20" HorizontalAlignment="Center"/>
                </StackPanel>
        </Button>

        <Button Grid.Column="4" Grid.Row="0"
                Width="200" Height="400"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#001199" Foreground="#FFD700"
                Command="{Binding RapportCommand}"
                CommandParameter="Agence">
                <StackPanel>
                        <Image Source="/Assets/icons8-rapport-financier-68.png" Width="60" Height="60" Margin="20"/>
                        <TextBlock Text="Rapport Financier" FontSize="20" HorizontalAlignment="Center"/>
                </StackPanel>
        </Button>
        </Grid>

</UserControl>