<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bankmanaging.ViewModels"
    x:Class="Bankmanaging.Views.DashView"
    x:DataType="vm:DashViewModel">

    <Grid RowSpacing="30" 
          ColumnSpacing="20" 
          ColumnDefinitions="*,*,*,*" 
          RowDefinitions="*" 
          HorizontalAlignment="Center" 
          VerticalAlignment="Center" 
          Margin="20">

        <Button Content="Client" 
                Grid.Column="0" Grid.Row="0"
                Width="200" Height="400"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#001199" Foreground="#FFD700"
                Command="{Binding ActionClientCommand}"/>

        <Button Content="Transaction" 
                Grid.Column="1" Grid.Row="0"
                Width="200" Height="400"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#001199" Foreground="#FFD700"
                Command="{Binding TransactionCommand}"/>
     
        <Button Content="Agence" 
                Grid.Column="2" Grid.Row="0"
                Width="200" Height="400"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#001199" Foreground="#FFD700"
                Command="{Binding ActionAgenceCommand}"
                CommandParameter="Agence"/>
                
        <Button Content="Historique" 
                Grid.Column="3" Grid.Row="0"
                Width="200" Height="400"  
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#001199" Foreground="#FFD700"
                Command="{Binding ActionHistoriqueCommand}"/>
        </Grid>

</UserControl>