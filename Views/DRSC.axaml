<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bankmanaging.ViewModels"
    x:Class="Bankmanaging.Views.DRSCView"
    x:DataType="vm:DRSCViewModel">

    <StackPanel>
        <Grid ColumnDefinitions="Auto,Auto">
            <StackPanel Width="400" VerticalAlignment="Center" Grid.Column="0">
                <Button Content="Depot"
                        Command="{Binding DepotCommand}"/>
                <Button Content="Retrait"
                        Command="{Binding RetraitCommand}"/>
                <Button Content="Credit"
                        Command="{Binding CreditCommand}"/>
            </StackPanel>
            <StackPanel Width="300" VerticalAlignment="Center" Grid.Column="1">
                <TextBlock Text="Solde"/>
                <TextBlock Text="Credit"/>
                <Button Content="Rembourser"
                        Command="{Binding RembourserCommand}"/>
                <Button Content="Se Deconnecter"
                        Command="{Binding RetourClientCommand}"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>