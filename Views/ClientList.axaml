<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bankmanaging.ViewModels"
    x:Class="Bankmanaging.Views.ClientView"
    x:DataType="vm:ClientViewModel">

    <StackPanel>
        <Grid>
            <StackPanel Width="400">
                <!--liste client-->
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Width="200">
                <Button Content="Connexion" 
                        HorizontalAlignment="Center"
                        Command="{Binding ConnecterCommand}"/>
                <Button Content="Nouveau" 
                        HorizontalAlignment="Center"/>
                <Button Content="Menu Principale" 
                        HorizontalAlignment="Center"
                        Command="{Binding MenuPCommand}"/>
            </StackPanel>
        </Grid>
    </StackPanel>

</UserControl>