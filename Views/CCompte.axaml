<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bankmanaging.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
    x:Class="Bankmanaging.Views.CCompteView"
    x:DataType="vm:CCompteViewModel">

    <Grid ColumnDefinitions="*,Auto">
        
        <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="20" Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="PIN" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"/>
                <TextBlock Text="Confirmation PIN" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"/>
        
                <TextBox Grid.Column="1" Grid.Row="0" 
                         Width="500"
                         Text="{Binding PIN, Mode=TwoWay}"/>
                <TextBox Grid.Column="1" Grid.Row="1" 
                         Width="500" 
                         Text="{Binding ConfirmationPIN, Mode=TwoWay}"/>
                
        </Grid>
        <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" RowDefinitions="Auto,Auto" RowSpacing="20" Margin="20">
            <Button Width="180" Height="50"
                    HorizontalAlignment="Center"
                    Background="#001199" Foreground="#FFD700"
                    Grid.Row="0"
                    Command="{Binding CCompteCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Assets/icons8-confirmer-50.png" Width="30" Height="30" Margin="5"/>
                            <TextBlock Text="Enregistrer" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
            </Button>
            <Button Width="180" Height="50"
                    HorizontalAlignment="Center"
                    Background="#001199" Foreground="#FFD700"
                    Grid.Row="1"
                    Command="{Binding AnnulerCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Assets/icons8-annuler-50.png" Width="30" Height="30" Margin="5"/>
                            <TextBlock Text="Annuler" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
            </Button>
        </Grid>
        </Grid>

</UserControl>