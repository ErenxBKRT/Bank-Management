<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bankmanaging.ViewModels"
    x:Class="Bankmanaging.Views.HeaderView"
    x:DataType="vm:HeaderViewModel">

    <DockPanel LastChildFill="True">
        <!-- Header sous forme de Grid pour occuper toute la largeur -->
        <Grid DockPanel.Dock="Top" 
              ColumnDefinitions="*, Auto" 
              Margin="0"
              Background="#001199">
            
            <TextBlock Grid.Column="0"
                       Text="LOGO et BANKKUN" 
                       Margin="5"
                       FontSize="24" 
                       FontWeight="ExtraBold"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Foreground="#FFD700"/>
            
            <Button Grid.Column="1"
                    Content="deconnexion" 
                    Margin="5"
                    Command="{Binding DeconnexionCommand}" 
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="#FFD700"/>
        </Grid>

        <!-- Le contenu principal s'adapte en dessous -->
        <ContentControl Content="{Binding ControlView}"/>
    </DockPanel>
</UserControl>

