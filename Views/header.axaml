<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bankmanaging.ViewModels"
    x:Class="Bankmanaging.Views.HeaderView"
    x:DataType="vm:HeaderViewModel">

    <StackPanel HorizontalAlignment="Center">
        <ScrollViewer>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="10">
            <TextBlock Text="LOGO et BANKKUN" 
                       FontSize="24" 
                       FontWeight="ExtraBold"
                       Margin="10,10,300,10"
                       HorizontalAlignment="Left"/>
            <Button Content="deconnexion" 
                    Command="{Binding DeconnexionCommand}" 
                    HorizontalAlignment="Right"
                    Margin="300,10,10,10"/>
        </StackPanel>
        </ScrollViewer>
        <ContentControl Content="{Binding ControlView}"/>
    </StackPanel>

</UserControl>

