<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bankmanaging.ViewModels"
    x:Class="Bankmanaging.Views.ConnexionView"
    x:DataType="vm:ConnexionViewModel">
    

<StackPanel Margin="24" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Bienvenue dans l'application BANKKUN"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center" />

        <TextBlock Text="ID Utilisateur A001 || CPT1234001 "
                   HorizontalAlignment="Center" />
        <TextBox Width="280"
                 Text="{Binding Username, Mode=TwoWay}"
                 PlaceholderText="Entrez votre ID utilisateur"
                 HorizontalAlignment="Center" TextAlignment="Center"/>

        <TextBlock Text="Mot de passe"
                   HorizontalAlignment="Center" />
        <TextBox Width="280"
                 Text="{Binding Password, Mode=TwoWay}"
                 PlaceholderText="Entrez votre mot de passe"
                 PasswordChar="*"
                 MaxLength="4"
                 HorizontalAlignment="Center" TextAlignment="Center"/>

        <Button Width="180" Height="50"
                    HorizontalAlignment="Center"
                    Grid.Row="1"
                    Command="{Binding LoginCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Assets/icons8-connexion-50.png" Width="30" Height="30" Margin="5"/>
                            <TextBlock Text="Se Connecter" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
        </Button>

        <TextBlock Text="{Binding StatusMessage}"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="280" />
    </StackPanel>


</UserControl>

   