<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bankmanaging.ViewModels"
    x:Class="Bankmanaging.Views.AgenceView"
    x:DataType="vm:AgenceViewModel">

    <Grid ColumnDefinitions="*,Auto">
        <Grid Grid.Column="0">
            <ListBox ItemsSource="{Binding Agences}">
                        <ListBox.ItemTemplate>
                                <DataTemplate>
                                <Border Margin="5" Padding="10">
                                        <StackPanel>
                                                <TextBlock Text="{Binding CodeAgence}"/>
                                                <TextBlock Text="{Binding Adresse}"/>
                                                <TextBlock Text="{Binding Solde}"/>
                                        </StackPanel>
                                </Border>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                </ListBox>
        </Grid>
        <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Width="200" RowDefinitions="Auto, Auto" RowSpacing="20" Margin="20">
                
                <Button Grid.Row="0"
                        Width="180" Height="50"
                        HorizontalAlignment="Center"
                        Command ="{Binding CreationACommand}">
                        <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/icons8-plus-50.png" Width="20" Height="20" Margin="3"/>
                                <TextBlock Text="Nouveau" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                </Button>
                <Button Grid.Row="1"
                        Width="180" Height="50"
                        HorizontalAlignment="Center"
                        Command="{Binding MenuCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="/Assets/icons8-menu-50.png" Width="30" Height="30" Margin="5"/>
                                <TextBlock Text="Menu Principale" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
        </Button>  
        </Grid>
    </Grid>

</UserControl>