<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bankmanaging.ViewModels"
    x:Class="Bankmanaging.Views.VirementView"
    x:DataType="vm:VirementViewModel">

    <Grid RowSpacing="30" ColumnSpacing="20" ColumnDefinitions="*,Auto" Margin="20">
        <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="20" Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Numero de compte" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"/>
                <TextBlock Text="Somme" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center"/>
                <TextBlock Text="Description" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center"/>
        
                <TextBox Grid.Column="1" Grid.Row="0" Width="500"/>
                <TextBox Grid.Column="1" Grid.Row="1" Width="500"/>
                <TextBox Grid.Column="1" Grid.Row="2" Width="500"/>
                
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="200">
            <Button Width="180" Height="50"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/Assets/icons8-confirmer-50.png" Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="Confirmer" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Width="180" Height="50"
                    HorizontalAlignment="Center"
                    Command="{Binding annulerCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="/Assets/icons8-annuler-50.png" Width="30" Height="30" Margin="5"/>
                            <TextBlock Text="Annuler" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
            </Button>
        </StackPanel>

    </Grid>
</UserControl>