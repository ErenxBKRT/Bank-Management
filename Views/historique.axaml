<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Bankmanaging.ViewModels"
    x:Class="Bankmanaging.Views.HistoriqueView"
    x:DataType="vm:HistoriqueViewModel">

    <StackPanel>
        <Grid>
            <StackPanel Width="400">
                <!--liste client-->
                <TextBlock Text="Historique"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Width="200">
                <Button Content="Menu Principale" 
                        HorizontalAlignment="Center"
                        Command="{Binding MenuCommand}"/>
            </StackPanel>
        </Grid>
    </StackPanel>

</UserControl>