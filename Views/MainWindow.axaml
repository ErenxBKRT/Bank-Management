<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bankmanaging.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="320"
        x:Class="Bankmanaging.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Bankmanaging">

	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<StackPanel>
		<!-- <StackPanel Margin="0,0,0,10">
			<Button Content="Trying connecting if work" Click="Connecting" HorizontalAlignment="Center"/>
			<TextBlock Name="Status" Text="Not Connected" TextAlignment="Center"/>
		</StackPanel> -->


		<ContentControl Content="{Binding CurrentView}"/>
	</StackPanel>

</Window>