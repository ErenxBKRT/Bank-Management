<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Bankmanaging.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="Bankmanaging.Views.ClientDetailView"
        x:DataType="vm:ClientDetailViewModel">

    <Grid ColumnDefinitions="*, Auto">
		<Grid Grid.Column="0">
			<Grid RowDefinitions="auto, *">

		        <TextBlock Text="Cartes bancaires" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" FontSize="20" Margin="10"/>
                 <ListBox ItemsSource="{Binding Comptes}" Grid.Row="1">
                <ListBox.ItemTemplate>
                                <DataTemplate>
                                <Border Margin="5" Padding="10">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                                <TextBlock Text="{Binding Numero}" Grid.Column="0" Grid.Row="0" FontSize="16" Margin="10"/>
                                                <TextBlock Text="{Binding Solde}" Grid.Column="0" Grid.Row="1" FontSize="16" Margin="10"/>
                                                <TextBlock Text="{Binding Credit}" Grid.Column="0" Grid.Row="2" FontSize="16" Margin="10"/>
                                                <TextBlock Text="{Binding Bloque}" Grid.Column="0" Grid.Row="3" FontSize="16" Margin="10"/>
                                                <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Width="200"
                                                                Command="{Binding $parent[UserControl].DataContext.BloquerCommand}"
                                                                CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                        <Image Source="/Assets/icons8-interdit-50.png" Width="20" Height="20" Margin="3"/>
                                                                        <TextBlock Text="Bloquer" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                        </Button>
													    <Button Width="200" 
																Command="{Binding $parent[UserControl].DataContext.DownPdfCommand}"
																CommandParameter="{Binding}">
														    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
															    <Image Source="/Assets/icons8-télécharger-32.png" Width="20" Height="20" Margin="3"/>
															    <TextBlock Text="Releve bancaire" HorizontalAlignment="Center" VerticalAlignment="Center"/>
														    </StackPanel>
													    </Button>
                                                 </StackPanel>
                                </Grid>
                                </Border>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
             </ListBox>
			</Grid>
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Right" Width="200" Margin="10" VerticalAlignment="Center">
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Client.Nom}" FontSize="16" Margin="10"/>
            <TextBlock Text="{Binding Client.Prenom}" FontSize="16" Margin="10"/>
        </StackPanel>
        
        <Button Grid.Row="1" Width="180" Height="50"
                HorizontalAlignment="Center"
                Background="#001199" Foreground="#FFD700"
                Command="{Binding CCompteCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/Assets/icons8-plus-50.png" Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="Nouveau" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
        </Button>

		

        <Button Grid.Row="2" Width="180" Height="50"
                HorizontalAlignment="Center"
                Background="#001199" Foreground="#FFD700"
                Command="{Binding RetourCommand}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/Assets/icons8-retour-30.png" Width="30" Height="30" Margin="5"/>
                        <TextBlock Text="Retour" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
        </Button>
		
    </Grid>
    
    </Grid>

</UserControl>
